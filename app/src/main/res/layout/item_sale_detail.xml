<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvDetailProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tomate"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvDetailQuantity"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvDetailQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3 x"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvDetailPrice"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvDetailPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50.00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvDetailSubtotal"
        android:layout_marginEnd="8dp"/>
        
    <TextView
        android:id="@+id/tvDetailSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="150.00"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>